# =========================================================
# CONFIGURACIÓN DE CONEXIÓN CON SUPABASE
# =========================================================
# 1. Ve a tu proyecto en https://supabase.com/dashboard
# 2. Entra a Project Settings -> API
# 3. Copia tu URL y anon/public key (o service_role key)
# 4. Crea un archivo .env en la raíz de este proyecto con estos valores:

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Opcional (para operaciones administrativas con bypass de RLS):
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Puerto local del servidor (por defecto 3000)
PORT=3000
